# Copy to deploy/.env (gitignored) and fill in.

# Domain pointing at this VPS; Caddy gets an HTTPS certificate for it.
API_DOMAIN=api.example.com

# The web app's origin(s), comma-separated. Browsers from any other site are refused.
ALLOWED_ORIGINS=https://bugshop.example.com

# ---------- accounts ----------

# Signs session cookies. Generate once and keep it secret: openssl rand -base64 32
# Changing it signs everyone out.
AUTH_SECRET=

# Mail for "confirm your email" and "reset your password" (https://resend.com).
# MAIL_FROM must use a domain you have verified with Resend.
RESEND_API_KEY=
MAIL_FROM=Bugshop <camp@example.com>

# Optional: "Continue with Google". Leave both empty to hide the button.
# Redirect URI to register: https://<API_DOMAIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: "Continue with Apple". Leave both empty to hide the button.
# APPLE_CLIENT_ID is the Services ID; APPLE_CLIENT_SECRET is the signed JWT (see deploy/README.md).
# Return URL to register: https://<API_DOMAIN>/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
